{
    "output_dims": 320,
    "loss":{
        "cov_loss_w":10,
        "std_loss_w":1, 
        "repr_loss_w":10
    },
    "transformations": {
        "time_vae":{
            "model":{
                "model_name": "same"
            },
            "model_name": "timeVAE",
            "verbose": 1,
            "train_epochs": "auto",
            "percentage": 0.2,
            "random_shift_ration": 0.004,
            "timeVAE": {
              "output_dims": 8,
              "hidden_layer_sizes": [50, 100, 200],
              "reconstruction_wt": 3.0,
              "batch_size": 16,
              "use_residual_conn": true,
              "trend_poly": 0,
              "custom_seas": null
            },
            "vae_dense": {
              "output_dims": 8,
              "hidden_layer_sizes": [50, 100, 200],
              "reconstruction_wt": 3.0,
              "batch_size": 8
            },
            "vae_conv": {
              "output_dims": 8,
              "hidden_layer_sizes": [50, 100, 200],
              "reconstruction_wt": 3.0,
              "batch_size": 16
            }
          }          
    },
    "main_transformation":[
        "default", {}
    ],
    "key_metric": "accuracy",
    "mean_mask_length": 3,
    "masking_ratio": 0.15,
    "mask_mode": "separate", 
    "@mask_mode/choice": ["seperate", "concurrent"],
    "mask_distribution": "geometric",
    "@mask_distribution/choice": ["geometric", "bernoulli"],
    "exclude_feats": null,
    "batch_size": 8,
    "optimizer": "Adam",
    "@optimier/choice": ["Adam", "RAdam"],
    "lr": 1e-2,
    "l2_reg": 0.02,
    "@epochs": 300,
    "epochs": 10000,
    "print_interval": 10,
    "evaluator": "svm"
}
