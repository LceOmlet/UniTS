{
    "loss":{
        "reconstruction_wt": 3.0
    },
    "mean_mask_length": 3,
    "masking_ratio": 0.15,
    "mask_mode": "separate", 
    "@mask_mode/choice": ["seperate", "concurrent"],
    "mask_distribution": "geometric",
    "@mask_distribution/choice": ["geometric", "bernoulli"],
    "exclude_feats": null,
    "batch_size": 16,
    "optimizer": "Adam",
    "@optimier/choice": ["Adam", "RAdam"],
    "lr": 1e-3,
    "l2_reg": 0,
    "@epochs": 10,
    "epochs": 16000,
    "print_interval": 10,
    "key_metric": "test_rec_loss",
    "save_condition": "epoch > 1000",
    "evaluator": "time_vae",
    "evaluate_interval": 20
}